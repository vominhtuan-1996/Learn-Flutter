# ========================================================
# 🚀 ENV.EXAMPLE - PRODUCTION DEPLOYMENT SECRETS
# ========================================================
# Hướng dẫn: 
# 1. Copy file này thành `.env` (không có đuôi .example)
# 2. Thay thế các giá trị giả định (placeholder) bằng thông tin thực tế
# 3. TUYỆT ĐỐI KHÔNG commit file `.env` lên git (hãy chắc chắn .env đã nằm trong .gitignore)

# --------------------------------------------------------
# 📱 FIREBASE CONFIGURATION
# --------------------------------------------------------
# Công dụng: Fastlane sử dụng các ID này để upload bản build lên đúng dự án Firebase App Distribution
FIREBASE_IOS_APP_ID=1:1234567890:ios:0a1b2c3d4e5f67890
FIREBASE_ANDROID_APP_ID=1:1234567890:android:0a1b2c3d4e5f67890

# Công dụng: Token dùng để xác thực với Firebase CLI trên CI/CD (không cần login tương tác)
# Lấy token bằng lệnh: `firebase login:ci`
FIREBASE_TOKEN=your_firebase_ci_token_here

# --------------------------------------------------------
# 🌊 SHOREBIRD CONFIGURATION
# --------------------------------------------------------
# Công dụng: Xác thực Shorebird CLI trong môi trường CI/CD (GitHub Actions, GitLab CI...)
# Lấy token bằng lệnh: `shorebird login:ci`
SHOREBIRD_TOKEN=your_shorebird_ci_token_here

# --------------------------------------------------------
# 🍏 IOS PROVISIONING & FASTLANE MATCH
# --------------------------------------------------------
# Công dụng: Định danh Bundle ID cho ứng dụng iOS
IOS_BUNDLE_ID=com.example.app

# Công dụng: Tên cụ thể của Provisioning Profile dành cho Enterprise Distribution
IOS_PROVISIONING_PROFILE_SPECIFIER=Enterprise_Profile_Name

# Công dụng: Mật khẩu giải mã certificate/profile kho lưu trữ (nếu dùng Fastlane Match)
MATCH_PASSWORD=your_match_decryption_password

# Công dụng: Mật khẩu ứng dụng (App-Specific Password) tạo từ appleid.apple.com 
# Dùng để xác thực Fastlane/Altool bỏ qua yêu cầu 2FA
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=your_apple_app_specific_password

# --------------------------------------------------------
# 🤖 ANDROID KEYSTORE CONFIGURATION
# --------------------------------------------------------
# Công dụng: Path và thông tin để ký (sign) file APK/AAB
ANDROID_KEYSTORE_PATH=../android/app/keystore.jks
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEYALIAS_NAME=your_key_alias
ANDROID_KEYALIAS_PASSWORD=your_key_alias_password
