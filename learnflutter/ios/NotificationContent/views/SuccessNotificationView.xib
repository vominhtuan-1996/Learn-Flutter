<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="21507" targetRuntime="AppleCocoa" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="NO" colorMatched="YES">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="SuccessNotificationView" customModule="NotificationContent" customModuleProvider="target">
            <connections>
                <outlet property="bodyLabel"    destination="bodyLbl"   id="s-out-body"/>
                <outlet property="expandButton" destination="expandBtn" id="s-out-expand"/>
                <outlet property="iconView"     destination="iconImg"   id="s-out-icon"/>
                <outlet property="okButton"     destination="okBtn"     id="s-out-ok"/>
                <outlet property="titleLabel"   destination="titleLbl"  id="s-out-title"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="rootView">
            <rect key="frame" x="0.0" y="0.0" width="375" height="210"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <imageView id="iconImg" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="163" y="20" width="48" height="48"/>
                    <color key="tintColor" red="0.133" green="0.545" blue="0.133" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstAttribute="width"  constant="48" id="s-icon-w"/>
                        <constraint firstAttribute="height" constant="48" id="s-icon-h"/>
                    </constraints>
                </imageView>
                <label id="titleLbl" translatesAutoresizingMaskIntoConstraints="NO" adjustsFontSizeToFit="NO" numberOfLines="1" textAlignment="center">
                    <rect key="frame" x="16" y="76" width="343" height="22"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                    <color key="textColor" red="0.067" green="0.094" blue="0.153" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <label id="bodyLbl" translatesAutoresizingMaskIntoConstraints="NO" adjustsFontSizeToFit="NO" numberOfLines="2" lineBreakMode="wordWrap" textAlignment="center">
                    <rect key="frame" x="16" y="104" width="343" height="36"/>
                    <fontDescription key="fontDescription" type="system" pointSize="13"/>
                    <color key="textColor" red="0.427" green="0.451" blue="0.502" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <button id="expandBtn" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" hidden="YES">
                    <rect key="frame" x="127" y="144" width="120" height="22"/>
                    <fontDescription key="fontDescription" type="system" pointSize="12"/>
                    <state key="normal" title="Xem them">
                        <color key="titleColor" red="0.133" green="0.545" blue="0.133" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </state>
                    <constraints>
                        <constraint firstAttribute="height" constant="22" id="s-expand-h"/>
                    </constraints>
                    <connections>
                        <action selector="toggleExpand:" destination="-1" id="s-act-expand"/>
                    </connections>
                </button>
                <button id="okBtn" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center">
                    <rect key="frame" x="16" y="174" width="343" height="38"/>
                    <color key="backgroundColor" red="0.133" green="0.545" blue="0.133" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <layer key="layer" cornerRadius="6"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                    <state key="normal" title="OK">
                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </state>
                    <constraints>
                        <constraint firstAttribute="height" constant="38" id="s-ok-h"/>
                    </constraints>
                    <connections>
                        <action selector="didTapOK:" destination="-1" id="s-act-ok"/>
                    </connections>
                </button>
            </subviews>
            <color key="backgroundColor" red="0.945" green="0.988" blue="0.957" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
                <constraint firstItem="iconImg"   firstAttribute="centerX" secondItem="rootView" secondAttribute="centerX" id="s-c1"/>
                <constraint firstItem="iconImg"   firstAttribute="top"     secondItem="rootView" secondAttribute="top"    constant="20" id="s-c2"/>
                <constraint firstItem="titleLbl"  firstAttribute="leading"  secondItem="rootView" secondAttribute="leading"  constant="16" id="s-c3"/>
                <constraint firstItem="titleLbl"  firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-16" id="s-c4"/>
                <constraint firstItem="titleLbl"  firstAttribute="top"      secondItem="iconImg"  secondAttribute="bottom" constant="8" id="s-c5"/>
                <constraint firstItem="bodyLbl"   firstAttribute="leading"  secondItem="rootView" secondAttribute="leading"  constant="16" id="s-c6"/>
                <constraint firstItem="bodyLbl"   firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-16" id="s-c7"/>
                <constraint firstItem="bodyLbl"   firstAttribute="top"      secondItem="titleLbl" secondAttribute="bottom" constant="6" id="s-c8"/>
                <constraint firstItem="expandBtn" firstAttribute="centerX"  secondItem="rootView" secondAttribute="centerX" id="s-c9"/>
                <constraint firstItem="expandBtn" firstAttribute="top"      secondItem="bodyLbl"  secondAttribute="bottom" constant="2" id="s-c10"/>
                <constraint firstItem="okBtn"     firstAttribute="leading"  secondItem="rootView" secondAttribute="leading"  constant="16" id="s-c11"/>
                <constraint firstItem="okBtn"     firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-16" id="s-c12"/>
                <constraint firstItem="okBtn"     firstAttribute="top"      secondItem="expandBtn" secondAttribute="bottom" constant="10" id="s-c13"/>
                <constraint firstItem="okBtn"     firstAttribute="bottom"   secondItem="rootView"  secondAttribute="bottom" constant="-16" relation="lessThanOrEqual" id="s-c14"/>
            </constraints>
        </view>
    </objects>
</document>
