<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="21507" targetRuntime="AppleCocoa" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="NO" colorMatched="YES">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="InfoNotificationView" customModule="NotificationContent" customModuleProvider="target">
            <connections>
                <outlet property="bodyLabel" destination="bodyLbl" id="outlet-body"/>
                <outlet property="expandButton" destination="expandBtn" id="outlet-expand"/>
                <outlet property="iconView" destination="iconImg" id="outlet-icon"/>
                <outlet property="openButton" destination="openBtn" id="outlet-open"/>
                <outlet property="skipButton" destination="skipBtn" id="outlet-skip"/>
                <outlet property="timeLabel" destination="timeLbl" id="outlet-time"/>
                <outlet property="titleLabel" destination="titleLbl" id="outlet-title"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="rootView">
            <rect key="frame" x="0.0" y="0.0" width="375" height="180"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <!-- Icon -->
                <imageView id="iconImg" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="14" y="14" width="32" height="32"/>
                    <color key="tintColor" red="0.388" green="0.400" blue="0.945" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="32" id="icon-w"/>
                        <constraint firstAttribute="height" constant="32" id="icon-h"/>
                    </constraints>
                </imageView>
                <!-- Title -->
                <label id="titleLbl" translatesAutoresizingMaskIntoConstraints="NO" adjustsFontSizeToFit="NO" numberOfLines="1">
                    <rect key="frame" x="56" y="14" width="200" height="32"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                    <color key="textColor" red="0.067" green="0.094" blue="0.153" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <!-- Time -->
                <label id="timeLbl" translatesAutoresizingMaskIntoConstraints="NO" adjustsFontSizeToFit="NO" numberOfLines="1" textAlignment="right">
                    <rect key="frame" x="317" y="21" width="44" height="18"/>
                    <fontDescription key="fontDescription" type="system" pointSize="11"/>
                    <color key="textColor" red="0.612" green="0.639" blue="0.686" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="44" id="time-w"/>
                    </constraints>
                </label>
                <!-- Divider -->
                <view id="dividerView" translatesAutoresizingMaskIntoConstraints="NO" contentMode="scaleToFill">
                    <rect key="frame" x="14" y="58" width="347" height="1"/>
                    <color key="backgroundColor" red="0.898" green="0.910" blue="0.922" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="1" id="div-h"/>
                    </constraints>
                </view>
                <!-- Body -->
                <label id="bodyLbl" translatesAutoresizingMaskIntoConstraints="NO" adjustsFontSizeToFit="NO" numberOfLines="2" lineBreakMode="wordWrap">
                    <rect key="frame" x="14" y="67" width="347" height="34"/>
                    <fontDescription key="fontDescription" type="system" pointSize="13"/>
                    <color key="textColor" red="0.427" green="0.451" blue="0.502" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <!-- Expand button -->
                <button id="expandBtn" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="left" contentVerticalAlignment="center">
                    <rect key="frame" x="14" y="105" width="120" height="22"/>
                    <fontDescription key="fontDescription" type="system" pointSize="12"/>
                    <state key="normal" title="Xem thêm ▾">
                        <color key="titleColor" red="0.388" green="0.400" blue="0.945" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </state>
                    <constraints>
                        <constraint firstAttribute="height" constant="22" id="expand-h"/>
                    </constraints>
                    <connections>
                        <action selector="toggleExpand:" destination="-1" id="action-expand"/>
                    </connections>
                </button>
                <!-- Open button -->
                <button id="openBtn" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                    <rect key="frame" x="14" y="135" width="168" height="36"/>
                    <color key="backgroundColor" red="0.388" green="0.400" blue="0.945" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <layer key="layer" cornerRadius="6"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                    <state key="normal" title="Mở">
                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </state>
                    <constraints>
                        <constraint firstAttribute="height" constant="36" id="open-h"/>
                    </constraints>
                    <connections>
                        <action selector="didTapOpen:" destination="-1" id="action-open"/>
                    </connections>
                </button>
                <!-- Skip button -->
                <button id="skipBtn" translatesAutoresizingMaskIntoConstraints="NO" contentHorizontalAlignment="center" contentVerticalAlignment="center">
                    <rect key="frame" x="190" y="135" width="171" height="36"/>
                    <color key="backgroundColor" red="0.898" green="0.910" blue="0.922" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <layer key="layer" cornerRadius="6"/>
                    <fontDescription key="fontDescription" type="system" pointSize="13"/>
                    <state key="normal" title="Bỏ qua">
                        <color key="titleColor" red="0.216" green="0.255" blue="0.318" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </state>
                    <constraints>
                        <constraint firstAttribute="height" constant="36" id="skip-h"/>
                    </constraints>
                    <connections>
                        <action selector="didTapSkip:" destination="-1" id="action-skip"/>
                    </connections>
                </button>
            </subviews>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <!-- Icon -->
                <constraint firstItem="iconImg" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="14" id="c1"/>
                <constraint firstItem="iconImg" firstAttribute="top" secondItem="rootView" secondAttribute="top" constant="14" id="c2"/>
                <!-- Time -->
                <constraint firstItem="timeLbl" firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-14" id="c3"/>
                <constraint firstItem="timeLbl" firstAttribute="centerY" secondItem="iconImg" secondAttribute="centerY" id="c4"/>
                <!-- Title -->
                <constraint firstItem="titleLbl" firstAttribute="leading" secondItem="iconImg" secondAttribute="trailing" constant="10" id="c5"/>
                <constraint firstItem="titleLbl" firstAttribute="trailing" secondItem="timeLbl" secondAttribute="leading" constant="-8" id="c6"/>
                <constraint firstItem="titleLbl" firstAttribute="centerY" secondItem="iconImg" secondAttribute="centerY" id="c7"/>
                <!-- Divider -->
                <constraint firstItem="dividerView" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="14" id="c8"/>
                <constraint firstItem="dividerView" firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-14" id="c9"/>
                <constraint firstItem="dividerView" firstAttribute="top" secondItem="iconImg" secondAttribute="bottom" constant="10" id="c10"/>
                <!-- Body -->
                <constraint firstItem="bodyLbl" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="14" id="c11"/>
                <constraint firstItem="bodyLbl" firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-14" id="c12"/>
                <constraint firstItem="bodyLbl" firstAttribute="top" secondItem="dividerView" secondAttribute="bottom" constant="8" id="c13"/>
                <!-- Expand -->
                <constraint firstItem="expandBtn" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="14" id="c14"/>
                <constraint firstItem="expandBtn" firstAttribute="top" secondItem="bodyLbl" secondAttribute="bottom" constant="2" id="c15"/>
                <!-- Open button -->
                <constraint firstItem="openBtn" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="14" id="c16"/>
                <constraint firstItem="openBtn" firstAttribute="top" secondItem="expandBtn" secondAttribute="bottom" constant="8" id="c17"/>
                <constraint firstItem="openBtn" firstAttribute="bottom" secondItem="rootView" secondAttribute="bottom" constant="-14" relation="lessThanOrEqual" id="c18"/>
                <!-- Skip button -->
                <constraint firstItem="skipBtn" firstAttribute="leading" secondItem="openBtn" secondAttribute="trailing" constant="8" id="c19"/>
                <constraint firstItem="skipBtn" firstAttribute="trailing" secondItem="rootView" secondAttribute="trailing" constant="-14" id="c20"/>
                <constraint firstItem="skipBtn" firstAttribute="centerY" secondItem="openBtn" secondAttribute="centerY" id="c21"/>
                <constraint firstItem="skipBtn" firstAttribute="width" secondItem="openBtn" secondAttribute="width" id="c22"/>
            </constraints>
        </view>
    </objects>
</document>
